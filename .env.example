# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (embedded Postgres). Production is Neon: DATABASE_URL is the POOLED
# endpoint (runtime connections), DATABASE_URL_UNPOOLED the direct host used by
# prisma migrate/seed/backups via datasource directUrl (see schema.prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelghana"
DATABASE_URL_UNPOOLED=""

# ─── Neon platform services (set automatically by `neon deploy`) ─────────────
# Provisioned on the production branch: Postgres, Neon Auth, Object Storage
# (bucket "assets"), Functions (sample "hello"). Not all are wired into app
# code yet (see DECISIONS.md D33); leave empty locally and rely on neon deploy.
NEON_BRANCH=""
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
NEON_FUNCTION_HELLO_BASE_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
SESSION_SECRET="change-me-32+-random-chars"
# Comma-separated list of allowed web origins (CORS + email link base).
# First entry is the canonical base used in email links; add your LAN IP if
# you browse the dev server from another device (see `next dev` Network URL).
WEB_APP_URL="http://localhost:3000"
# Origins of the standalone admin console (CORS allowlist; comma-separated,
# parsed like WEB_APP_URL). Dev console: pnpm --filter @travelghana/web dev:admin.
ADMIN_APP_URL="http://localhost:3001"
# Admin subdomain split (D21): set BOTH in production, e.g. "admin.travelghana.com".
# When set, the admin host serves only admin + auth routes, stray paths funnel
# to /admin, travelghana.com/admin redirects there, and admin-host pages are
# noindex. Leave empty for the default single-origin app.
ADMIN_HOST=""
NEXT_PUBLIC_ADMIN_HOST=""
# Main site URL for admin-site chrome ("Back to site", header/footer links).
NEXT_PUBLIC_WEB_APP_URL=""

# Bootstrap admin (auto-created on API start when set; §40 secrets management)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Transactional email (D34). MAILER_PROVIDER = "console" (dev default: links
# print in the API console) or "brevo" (real delivery; needs a Brevo account,
# free tier = 300 emails/day, single verified sender before any domain exists).
# MAIL_FROM_EMAIL must be a sender verified inside Brevo (their dashboard).
MAILER_PROVIDER="console"
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="TravelGhana"

# ─── Redis (background jobs, sessions later) ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Maps (D4: Mapbox first, behind MapsAdapter) ─────────────────────────────
MAPBOX_PUBLIC_TOKEN=""
MAPBOX_SECRET_TOKEN=""

# ─── Payments (D1: Paystack first, merchant of record) ───────────────────────
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Trip planner data source: "api" (connected backend) or "demo" (browser-only preview).
NEXT_PUBLIC_TRIPS_SOURCE="api"

# ─── Monitoring (planned) ────────────────────────────────────────────────────
SENTRY_DSN=""
POSTHOG_KEY=""

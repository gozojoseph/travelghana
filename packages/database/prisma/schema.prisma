// TravelGhana — draft schema v0.2 (implements docs/ERD.md)
// Money: integer minor units (pesewas) + currencyCode everywhere. No floats. (D8)
// D1 merchant-of-record; D3 multi-role; D5 operator-first; §11 privacy-scoped needs.

generator client {
  provider = "prisma-client-js"
  // Project-relative output so the client is resolvable across pnpm workspaces
  // — import PrismaClient and types from @travelghana/database, never from
  // @prisma/client directly.
  output = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma CLI (migrate/push/studio) and one-off connections use the direct
  // URL; on Neon this is the non-pooler host because transaction-mode pooling
  // (pgbouncer) breaks prepared statements. The generated Client itself still
  // connects through `url` (pooled in production; same host locally).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  TRAVELER
  DRIVER
  TOUR_OPERATOR
  HOTEL_MANAGER
  TRANSPORT_COMPANY
  EXPERIENCE_PROVIDER
  ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  phone           String?
  name            String?
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships   RoleMembership[]
  sessions      Session[]
  provider      Provider?   // 1:1 (D3: a user may also operate as a provider)
  driverProfile Driver?     // 1:1
  trips         Trip[]      @relation("TripOwner")
  bookings      Booking[]
  packageBookings PackageBooking[]
  reviews       Review[]
  favorites     Favorite[]
  messages      Message[]
  participants  ConversationParticipant[]
  notifications Notification[]
  documents     Document[]  @relation("DocumentOwner")
  auditLogs     AuditLog[]  @relation("AuditActor")
  enquiries     Enquiry[]
  emailTokens   EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  pageViews     PageView[]
  packageReviews PackageReview[]
  listingBookings ListingBooking[]
}

model RoleMembership {
  id        String           @id @default(cuid())
  userId    String
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  codeHash  String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  codeHash   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog (discovery) ─────────────────────────────────────────────────────

enum DestinationCategory {
  BEACH
  HISTORICAL
  CULTURAL
  NATURE
  CITY
  FOOD
  ADVENTURE
}

model Region {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  mapPolygon  Json?
  sort        Int     @default(0)

  cities City[]
}

model City {
  id          String  @id @default(cuid())
  regionId    String
  slug        String
  name        String
  description String?
  lat         Float
  lng         Float

  region            Region             @relation(fields: [regionId], references: [id])
  destinations      Destination[]
  attractions       Attraction[]
  providers         Provider[]
  tours             Tour[]
  experiences       Experience[]
  hotels            Hotel[]
  transportServices TransportService[]
  events            Event[]

  @@unique([regionId, slug])
}

model Destination {
  id           String              @id @default(cuid())
  cityId       String
  slug         String              @unique // globally unique — powers SEO routes /destinations/[slug]
  name         String
  category     DestinationCategory
  summary      String?
  description  String?
  lat          Float
  lng          Float
  heroImageUrl String?
  featured     Boolean             @default(false)
  published    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  city           City            @relation(fields: [cityId], references: [id])
  attractions    Attraction[]
  itineraryItems ItineraryItem[]
  packages       Package[]

  @@index([category, published])
}

model Attraction {
  id            String   @id @default(cuid())
  destinationId String?
  cityId        String?
  slug          String   @unique
  name          String
  description   String?
  lat           Float
  lng           Float
  category      String?
  published     Boolean  @default(true)

  destination    Destination?    @relation(fields: [destinationId], references: [id])
  city           City?           @relation(fields: [cityId], references: [id])
  itineraryItems ItineraryItem[]

  @@index([cityId])
}

// ─── Marketplace ─────────────────────────────────────────────────────────────

enum ProviderType {
  TOUR_OPERATOR
  HOTEL
  EXPERIENCE_PROVIDER
  TRANSPORT_COMPANY
  RESTAURANT
  EVENT_ORGANIZER
  DRIVER_PARTNER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

/** Status lifecycle for listings and services. DRAFT|PENDING_REVIEW|PUBLISHED|PAUSED|ARCHIVED. */
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  ARCHIVED
}

/** Structured geographic context on providers and listings (D4: Mapbox-compatible). */
model Location {
  id                 String   @id @default(cuid())
  address            String?
  lat                Float?
  lng                Float?
  cityId             String?
  regionId           String?
  country            String   @default("Ghana")
  postalCode         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // cityId/regionId are direct FK scalars (not a relation): inverse arrays
  // exist on City/Region but are pre-existing schema gaps mirroring
  // Booking.*; generated client does not need them.
}

model Provider {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  type               ProviderType
  name               String
  slug               String             @unique
  description        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  contactEmail       String?
  contactPhone       String?
  logoUrl            String?
  cityId             String?
  serviceArea        String?
  coordinatesLat     Float?
  coordinatesLng     Float?
  country            String   @default("Ghana")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user              User?              @relation(fields: [userId], references: [id])
  // Inverse not materialized: direct FK scalars (cityId/regionId). Inverse
  // arrays exist on City/Region but are pre-existing schema gaps mirroring
  // Booking.*; generated client does not need them.
  city              City?              @relation(fields: [cityId], references: [id])
  tours             Tour[]
  experiences       Experience[]
  listings          Listing[]
  hotels            Hotel[]
  transportServices TransportService[]
  vehicles          Vehicle[]
  drivers           Driver[]
  events            Event[]
  bookings          Booking[]
  reviews           Review[]
  payouts           ProviderPayout[]
  documents         Document[]

  @@index([type, verificationStatus])
}

model Tour {
  id             String   @id @default(cuid())
  providerId     String
  slug           String
  title          String
  summary        String?
  description    String?
  durationHours  Int?
  days           Int?
  groupMin       Int      @default(1)
  groupMax       Int      @default(10)
  basePriceMinor Int
  currencyCode   String   @default("GHS")
  cityId         String?
  meetingPoint   String?
  category       String?
  published      Boolean  @default(false)
  heroImageUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider          @relation(fields: [providerId], references: [id])
  city     City?             @relation(fields: [cityId], references: [id])
  slots    AvailabilitySlot[]
  bookings Booking[]
  itineraryItems ItineraryItem[]

  @@unique([providerId, slug])
  @@index([cityId, published])
}

model Experience {
  id              String   @id @default(cuid())
  providerId      String
  slug            String
  title           String
  description     String?
  durationMinutes Int?
  priceMinor      Int
  currencyCode    String   @default("GHS")
  cityId          String?
  category        String?
  published       Boolean  @default(false)
  heroImageUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider  Provider          @relation(fields: [providerId], references: [id])
  city      City?             @relation(fields: [cityId], references: [id])
  slots     AvailabilitySlot[]
  bookings  Booking[]
  itineraryItems ItineraryItem[]

  @@unique([providerId, slug])
  @@index([cityId, published])
}

// ─── Reusable listings (D8: integer minor units, GHS default) ────────────────

model Listing {
  id                 String            @id @default(cuid())
  providerId         String
  slug               String
  title              String
  status             ListingStatus     @default(DRAFT)
  description        String?
  serviceArea        String?
  durationMinutes    Int?
  capacity           Int               @default(1)
  priceMinor         Int
  currencyCode       String            @default("GHS")
  cityId             String?
  regionId           String?
  coordinatesLat     Float?
  coordinatesLng     Float?
  address            String?
  meetingPoint       String?
  category           String?
  whatIsIncluded     String?
  whatIsExcluded     String?
  requirements       String?
  cancellationPolicy String?
  heroImageUrl       String?
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  provider Provider    @relation(fields: [providerId], references: [id])
  extension ListingExtension?
  requests ListingBooking[]

  @@unique([providerId, slug])
  @@index([providerId, status, cityId])
  @@index([status, publishedAt])
}

// ─── Listing/Service extension (reusable listing model) ──────────────────────

model ListingExtension {
  id              String   @id @default(cuid())
  listingId       String   @unique
  content         String?
  updatedAt       DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ─── Curated packages (admin-managed, platform-owned) ───────────────────────

/** Lifecycle for admin-curated packages: not provider inventory, so no review queue. */
enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * A multi-day travel package curated by TravelGhana admins. The day-by-day
 * outline is editorial content (not bookable inventory yet) and is replaced as
 * a set on update.
 */
model Package {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?
  description    String?
  destinationId  String?
  durationDays   Int
  durationNights Int           @default(0)
  priceMinor     Int
  currencyCode   String        @default("GHS")
  heroImageUrl   String?
  inclusions     String?
  exclusions     String?
  status         PackageStatus @default(DRAFT)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  destination Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  days        PackageDay[]
  itineraryItems ItineraryItem[]
  packageBookings PackageBooking[]
  departures      PackageDeparture[]
  packageReviews  PackageReview[]

  @@index([status, featured])
  @@index([destinationId])
}

/** One editorial day in a package outline; unique per package. */
model PackageDay {
  id            String   @id @default(cuid())
  packageId     String
  dayNumber     Int
  title         String
  description   String?
  meals         String?
  accommodation String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
  @@index([packageId])
}

// ─── Gallery (admin-managed, platform-owned) ────────────────────────────────

/**
 * One editorial image in the public gallery. Images are referenced by URL for
 * now (no upload/storage pipeline yet); admins curate the caption, grouping and
 * order. Draft items stay invisible until published.
 */
model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  imageUrl  String
  category  String?
  location  String?
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model Hotel {
  id           String  @id @default(cuid())
  providerId   String
  slug         String
  name         String
  description  String?
  starRating   Int?
  cityId       String?
  address      String?
  lat          Float?
  lng          Float?
  checkInTime  String?
  checkOutTime String?
  published    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  rooms    Room[]

  @@unique([providerId, slug])
  @@index([cityId, published])
}

model Room {
  id                 String  @id @default(cuid())
  hotelId            String
  name               String
  roomType           String?
  capacity           Int
  beds               Int     @default(1)
  pricePerNightMinor Int
  currencyCode       String  @default("GHS")
  totalRooms         Int     @default(1)
  description        String?
  amenities          String[]

  hotel    Hotel       @relation(fields: [hotelId], references: [id])
  nights   RoomNight[]
  bookings Booking[]

  @@index([hotelId])
}

model Event {
  id                  String   @id @default(cuid())
  organizerProviderId String?
  slug                String
  name                String
  description         String?
  venueCityId         String?
  venueName           String?
  startsAt            DateTime
  endsAt              DateTime
  published           Boolean  @default(false)
  heroImageUrl        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organizer Provider? @relation(fields: [organizerProviderId], references: [id])
  venueCity City?     @relation(fields: [venueCityId], references: [id])

  @@index([venueCityId, startsAt])
  @@index([organizerProviderId])
}

// ─── Transport (Vehicle + Driver + Service) ──────────────────────────────────

enum TransportServiceType {
  AIRPORT_TRANSFER
  FULL_DAY_DRIVER
  MULTI_DAY_DRIVER
  POINT_TO_POINT
  GROUP_TRANSPORT
  EVENT_TRANSPORT
  CORPORATE_TRANSPORT
}

enum PricingModel {
  FLAT
  PER_DAY
  PER_KM
}

enum VehicleCategory {
  SEDAN
  SUV
  MINIVAN
  VAN
  HIACE
  BUS
  LUXURY
  OTHER
}

model Driver {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  providerId         String?
  displayName        String
  photoUrl           String?
  licenseNumber      String?
  licenseVerifiedAt  DateTime?
  yearsExperience    Int                @default(0)
  languages          String[]
  serviceCityIds     String[]
  bio                String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user          User?           @relation(fields: [userId], references: [id])
  provider      Provider?       @relation(fields: [providerId], references: [id])
  vehicles      DriverVehicle[]
  ownedVehicles Vehicle[]       @relation("OwnerDriver")
  bookings      Booking[]

  @@index([providerId])
}

model Vehicle {
  id                    String             @id @default(cuid())
  providerId            String?
  driverId              String?
  category              VehicleCategory
  make                  String
  model                 String
  year                  Int?
  passengerCapacity     Int
  luggageCapacity       Int?
  hasAc                 Boolean            @default(true)
  accessibilityFeatures String?
  photos                String[]
  plateNumber           String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  provider    Provider?       @relation(fields: [providerId], references: [id])
  driver      Driver?         @relation("OwnerDriver", fields: [driverId], references: [id])
  driverLinks DriverVehicle[]

  @@index([category])
}

model DriverVehicle {
  driverId  String
  vehicleId String
  isPrimary Boolean @default(false)

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([driverId, vehicleId])
}

model TransportService {
  id             String               @id @default(cuid())
  providerId     String
  serviceType    TransportServiceType
  vehicleCategory VehicleCategory?
  cityId         String?
  basePriceMinor Int
  currencyCode   String               @default("GHS")
  pricingModel   PricingModel         @default(FLAT)
  published      Boolean              @default(false)
  rules          Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  provider Provider          @relation(fields: [providerId], references: [id])
  city     City?             @relation(fields: [cityId], references: [id])
  slots    AvailabilitySlot[]
  bookings Booking[]

  @@index([serviceType, cityId, published])
}

// ─── Trip ────────────────────────────────────────────────────────────────────

enum TripStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/** Travel pace preference captured by the planner wizard. */
enum TravelPace {
  RELAXED
  BALANCED
  PACKED
}

/** Budget tier preference captured by the planner wizard. */
enum BudgetTier {
  BUDGET
  MIDRANGE
  PREMIUM
  FLEXIBLE
}

/** Whether the stated budget covers one traveler or the whole group. */
enum BudgetType {
  PER_PERSON
  PER_GROUP
}

/** Planner interests — recommendation signal captured by the wizard. */
enum TripInterest {
  CULTURE_HERITAGE
  BEACHES_COASTAL
  NATURE_WILDLIFE
  ADVENTURE_HIKING
  FOOD_CUISINE
  FESTIVALS_EVENTS
  ART_CRAFTS_SHOPPING
  NIGHTLIFE_ENTERTAINMENT
  RELAXATION_WELLNESS
  FAMILY_FRIENDLY
}

model Trip {
  id           String     @id @default(cuid())
  ownerUserId  String
  name         String
  startDate    DateTime?
  endDate      DateTime?
  status       TripStatus @default(PLANNING)
  adults       Int        @default(1)
  children     Int        @default(0)
  budgetMinor  Int?
  currencyCode String     @default("GHS")
  notes        String?

  // Planner preferences (D18 wizard). Arrays/bools default empty so existing
  // rows and API-created trips stay valid without a wizard pass.
  interests              TripInterest[] @default([])
  travelPace             TravelPace     @default(BALANCED)
  budgetTier             BudgetTier     @default(FLEXIBLE)
  budgetType             BudgetType     @default(PER_GROUP)
  budgetIncludesFlights  Boolean        @default(false)
  arrivalPoint           String?
  destinationPreferences String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User             @relation("TripOwner", fields: [ownerUserId], references: [id])
  travelers     TripTraveler[]
  days          ItineraryDay[]
  items         ItineraryItem[]
  bookings      Booking[]
  conversations Conversation[]
  enquiries     Enquiry[]
  shares        TripShare[]

  @@index([ownerUserId, status])
}

// ─── Trip sharing (D19: sanitized companion view, token-gated) ───────────────

/**
 * A token-gated read link for a trip. The token grants access to a sanitized,
 * derived view of the plan (see trips.share.buildTripShareView) — never
 * prices, notes, planner warnings, or traveler needs (§11). Creating a new
 * share revokes the previous active one; revocation is a stamped timestamp so
 * old tokens fail closed.
 */
model TripShare {
  id        String    @id @default(cuid())
  tripId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, revokedAt])
  @@index([tripId, createdAt])
}

model TripTraveler {
  id       String  @id @default(cuid())
  tripId   String
  name     String?
  ageGroup String?
  isOwner  Boolean @default(false)

  trip  Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  needs TravelerNeed[]

  @@index([tripId])
}

enum NeedCategory {
  ACCESSIBILITY
  MOBILITY
  DIETARY
  ALLERGY
  CHILDREN
  SENIOR
  PREGNANCY
  MEDICATION
  ASSISTANCE
  OTHER
}

enum NeedVisibility {
  NONE
  MINIMAL
  FULL
}

// §11: sensitive traveler needs — visibility-scoped, consent-gated, access audited.
model TravelerNeed {
  id                        String         @id @default(cuid())
  tripTravelerId            String
  category                  NeedCategory
  details                   String?
  consentGivenAt            DateTime?
  providerVisibility        NeedVisibility @default(NONE)
  detailsVisibleToProviders Boolean        @default(false)

  tripTraveler TripTraveler @relation(fields: [tripTravelerId], references: [id], onDelete: Cascade)

  @@index([tripTravelerId])
}

model ItineraryDay {
  id        String    @id @default(cuid())
  tripId    String
  dayNumber Int
  date      DateTime?
  title     String?
  notes     String?

  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@unique([tripId, dayNumber])
}

enum ItineraryItemType {
  BOOKING
  ATTRACTION
  RESTAURANT
  EVENT
  NOTE
  TRANSPORT
  ACCOMMODATION
  TOUR
  EXPERIENCE
}

/** How an itinerary estimate is charged (D18 — estimates, never confirmed prices). */
enum PricingBasis {
  PER_PERSON
  PER_GROUP
  PER_NIGHT
  PER_SERVICE
  TOTAL
}

/** Where an estimate came from: a listing snapshot or the traveler's own number. */
enum EstimateSource {
  LISTING
  MANUAL
}

/**
 * One activity/idea in a trip. Items may be scheduled on an ItineraryDay or
 * sit in the trip-level "unscheduled ideas" list (itineraryDayId null). Cost
 * fields are *estimates* — never treated as confirmed prices or bookings.
 */
model ItineraryItem {
  id             String            @id @default(cuid())
  tripId         String
  itineraryDayId String?
  sortOrder      Int
  startTime      DateTime?
  endTime        DateTime?
  title          String
  itemType       ItineraryItemType
  bookingId      String?
  attractionId   String?
  destinationId  String?
  tourId         String?
  experienceId   String?
  packageId      String?

  estimatedCostMinor Int?
  currencyCode       String?
  pricingBasis       PricingBasis?
  estimateSource     EstimateSource?
  priceSnapshotAt    DateTime?

  notes     String?
  createdAt DateTime @default(now())

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day         ItineraryDay? @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  attraction  Attraction?  @relation(fields: [attractionId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])
  tour        Tour?        @relation(fields: [tourId], references: [id])
  experience  Experience?  @relation(fields: [experienceId], references: [id])
  package     Package?     @relation(fields: [packageId], references: [id])

  @@index([tripId, itineraryDayId, sortOrder])
}

// ─── Booking & availability ──────────────────────────────────────────────────

enum BookableType {
  TOUR
  EXPERIENCE
  TRANSPORT
  HOTEL_ROOM
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
}

model AvailabilitySlot {
  id                 String       @id @default(cuid())
  serviceableType    BookableType
  tourId             String?
  experienceId       String?
  transportServiceId String?
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  bookedCount        Int          @default(0)
  isClosed           Boolean      @default(false)
  createdAt          DateTime     @default(now())

  tour             Tour?              @relation(fields: [tourId], references: [id])
  experience       Experience?        @relation(fields: [experienceId], references: [id])
  transportService TransportService?  @relation(fields: [transportServiceId], references: [id])
  holds            AvailabilityHold[]
  bookings         Booking[]

  @@index([tourId, startsAt])
  @@index([experienceId, startsAt])
  @@index([transportServiceId, startsAt])
}

model RoomNight {
  id        String   @id @default(cuid())
  roomId    String
  date      DateTime @db.Date
  available Int

  room  Room              @relation(fields: [roomId], references: [id])
  holds AvailabilityHold[]

  @@unique([roomId, date])
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model AvailabilityHold {
  id                String     @id @default(cuid())
  userId            String
  slotId            String?
  roomNightId       String?
  expiresAt         DateTime
  consumedBookingId String?  @unique
  status            HoldStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())

  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id])
  roomNight RoomNight?        @relation(fields: [roomNightId], references: [id])
  booking   Booking?          @relation("HoldBooking")

  @@index([expiresAt, status])
}

model Booking {
  id               String        @id @default(cuid())
  code             String        @unique // human-readable, e.g. TG-2026-000123
  userId           String
  tripId           String?
  providerId       String
  bookableType     BookableType
  tourId           String?
  experienceId     String?
  transportServiceId String?
  roomId           String?
  slotId           String?
  holdId           String? @unique
  driverId         String? // requested/assigned driver for transport bookings
  startDate        DateTime
  endDate          DateTime?
  paxAdults        Int           @default(1)
  paxChildren      Int           @default(0)
  amountMinor      Int
  currencyCode     String        @default("GHS")
  status           BookingStatus @default(PENDING_PAYMENT)
  specialRequests  String?
  cancellationPolicy Json?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User               @relation(fields: [userId], references: [id])
  trip             Trip?              @relation(fields: [tripId], references: [id])
  provider         Provider           @relation(fields: [providerId], references: [id])
  tour             Tour?              @relation(fields: [tourId], references: [id])
  experience       Experience?        @relation(fields: [experienceId], references: [id])
  transportService TransportService?  @relation(fields: [transportServiceId], references: [id])
  room             Room?              @relation(fields: [roomId], references: [id])
  slot             AvailabilitySlot?  @relation(fields: [slotId], references: [id])
  hold             AvailabilityHold?  @relation("HoldBooking", fields: [holdId], references: [id])
  driver           Driver?            @relation(fields: [driverId], references: [id])
  payments         Payment[]
  commissions      Commission[]
  refunds          Refund[]
  review           Review?
  itineraryItems   ItineraryItem[]
  conversations    Conversation[]

  @@index([userId, status])
  @@index([providerId, status])
}

// ─── Money (D1: platform merchant of record) ─────────────────────────────────

enum PaymentProviderName {
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id               String              @id @default(cuid())
  bookingId        String
  provider         PaymentProviderName
  reference        String              @unique
  amountMinor      Int
  currencyCode     String              @default("GHS")
  status           PaymentStatus       @default(INITIALIZED)
  authorizationUrl String?
  paidAt           DateTime?
  meta             Json?
  createdAt        DateTime            @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id])
  transactions Transaction[]
  refunds      Refund[]

  @@index([bookingId])
}

enum TransactionType {
  CHARGE
  REFUND
  PAYOUT
  ADJUSTMENT
}

model Transaction {
  id           String          @id @default(cuid())
  paymentId    String?
  type         TransactionType
  amountMinor  Int // signed: +charge −refund −payout
  currencyCode String          @default("GHS")
  status       String
  description  String?
  createdAt    DateTime        @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  bookingId   String
  amountMinor Int
  reason      String?
  status      String
  providerRef String?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Commission {
  id           String   @id @default(cuid())
  bookingId    String
  rateBps      Int
  amountMinor  Int
  currencyCode String   @default("GHS")
  status       String
  createdAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model ProviderPayout {
  id              String    @id @default(cuid())
  providerId      String
  periodStart     DateTime
  periodEnd       DateTime
  grossMinor      Int
  commissionMinor Int
  netMinor        Int
  currencyCode    String    @default("GHS")
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
}

// ─── Engagement & platform ───────────────────────────────────────────────────

enum ConversationType {
  TRAVELER_PROVIDER
  TRAVELER_DRIVER
  TRAVELER_SUPPORT
  PROVIDER_OPS
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  tripId    String?
  bookingId String?
  createdAt DateTime         @default(now())

  trip         Trip?                     @relation(fields: [tripId], references: [id])
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tripId])
  @@index([bookingId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderUserId   String?
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  type      String
  payload   Json
  status    String              @default("QUEUED")
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

enum ReviewTargetType {
  HOTEL
  DRIVER
  TOUR
  EXPERIENCE
  TRANSPORT
}

model Review {
  id           String           @id @default(cuid())
  bookingId    String           @unique // verified bookings only (§22)
  authorUserId String
  providerId   String
  targetType   ReviewTargetType
  rating       Int
  body         String?
  photos       String[]
  status       String           @default("PUBLISHED")
  createdAt    DateTime         @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  author   User     @relation(fields: [authorUserId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
}

enum FavoriteTargetType {
  DESTINATION
  TOUR
  EXPERIENCE
  HOTEL
  ATTRACTION
  RESTAURANT
  EVENT
}

model Favorite {
  id         String             @id @default(cuid())
  userId     String
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONVERTED
  CLOSED
}

model Enquiry {
  id                String        @id @default(cuid())
  code              String        @unique
  userId            String?
  name              String
  email             String
  phone             String?
  tripId            String?
  startDate         DateTime?
  endDate           DateTime?
  adults            Int           @default(1)
  children          Int           @default(0)
  destinations      String[]
  interests         String[]
  budgetRange       String?
  accommodationPref String?
  transportPref     String?
  specialRequests   String?
  status            EnquiryStatus @default(NEW)
  assignedAdminId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  trip Trip? @relation(fields: [tripId], references: [id])

  @@index([status, createdAt])
}

model Document {
  id          String    @id @default(cuid())
  ownerUserId String?
  providerId  String?
  type        String
  fileUrl     String
  verifiedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  owner    User?     @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model SiteSettings {
  /// Singleton row (fixed id) holding the public contact + social info shown in
  /// the footer and the about page. Edited by admins at any time (D24); every
  /// field is optional so the public surfaces hide what is not filled in.
  /// D44: the two payment instruction blocks are not public surface - they are
  /// merged into booking confirmation emails verbatim (no amounts are added by
  /// the platform; the traveler pays manually by Mobile Money or bank).
  id               String   @id @default("site")
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  facebookUrl      String?
  instagramUrl     String?
  twitterUrl       String?
  youtubeUrl       String?
  momoInstructions String?
  bankInstructions String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

/// A booking request for one curated package (D25). Packages are platform-owned
/// editorial journeys without provider inventory, so this stays a lean request
/// row: the traveler books, no payment is taken until a human confirms
/// availability (the Payment rails apply to the provider-scoped Booking model).
model PackageBooking {
  id        String        @id @default(cuid())
  code      String        @unique // human-readable reference, e.g. PB-4K9A2C
  userId    String
  packageId String
  startDate DateTime
  adults    Int           @default(1)
  children  Int           @default(0)
  notes     String?
  // Manual payments (D44): the date the team marked a confirmed booking as
  // paid (bank transfer or Mobile Money reference). Null until then.
  paidAt    DateTime?
  status    BookingStatus @default(PENDING_PAYMENT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  // Departures (D41): set-date journeys carry a booked departure. Nullable so
  // open-dated packages and legacy requests stay valid without one.
  departureId String?

  departure PackageDeparture? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  review    PackageReview?

  @@index([userId, status])
  @@index([packageId, status])
  @@index([departureId])
}

/// Seat-managed departure date (D41/D42): an admin adds explicit dates with a
/// seat count; travelers pick from future dates with remaining seats. A
/// booking holds seats until it is cancelled/refunded/expired; remaining seats
/// are derived (seats minus party size of live bookings), never decremented.
model PackageDeparture {
  id        String   @id @default(cuid())
  packageId String
  date      DateTime @db.Date
  seats     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package  Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings PackageBooking[]

  @@unique([packageId, date])
}

/// Package reviews (D42) - the only reviewable surface in Phase 2, packages
/// only. A traveler may review once a booking that the admin CONFIRMED exists
/// (a booked trip, not just an account), the row starts PENDING and turns
/// visible only after an admin approves it; a rejection keeps its reason.
model PackageReview {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  packageId    String
  userId       String
  rating       Int
  body         String?
  status       String   @default("PENDING")
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking PackageBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([packageId, status])
  @@index([userId, status])
}

/// Quote-only transport request (D43): a signed-in traveler asks about one
/// published listing owned by a transport provider (transport company or
/// driver partner). There are no prices, no seats and no payment here - the
/// team replies with a written quote by email and confirms or cancels; "paid"
/// is off-platform and stays out of the data model.
model ListingBooking {
  id        String   @id @default(cuid())
  code      String   @unique // human-readable reference, e.g. TB-4K9A2C
  userId    String
  listingId String
  startDate DateTime
  partySize Int      @default(1)
  notes     String?
  // PENDING (default) -> CONFIRMED | CANCELLED by admin decision. Plain string
  // (like PackageReview.status) because the package payment-rail statuses do
  // not apply to a quote conversation.
  status    String   @default("PENDING")
  // The latest written quote from the team, kept so the traveler can re-read
  // it on their account page and not just in their mailbox.
  quoteNote String?
  quoteAt   DateTime?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([userId, status])
  @@index([listingId])
  @@index([status, createdAt])
}

/// First-party clickstream event (D37): one row per browsed page or tracked
/// action. Written by POST /api/track from the web browser; never stores
/// query strings, emails or free user content. Sessions are 30-minute
/// browser buckets maintained client-side; userId correlates signed-in use.
model PageView {
  id         String    @id @default(cuid())
  sessionId  String
  visitorId  String
  userId     String?
  path       String
  referrer   String?
  device     String
  kind       String
  name       String?
  meta       Json?
  occurredAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId, occurredAt])
  @@index([visitorId])
  @@index([path])
  @@index([userId])
}

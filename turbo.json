{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": [],
      "outputs": ["src/generated/**"],
      "inputs": ["prisma/schema.prisma"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate"]
    },
    "lint": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^db:generate"],
      "cache": false
    }
  }
}